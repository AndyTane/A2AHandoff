!/tests/test-draft-readback.ps1
!/tests/test-plain-correlation.ps1
!/tests/test-preparation-hold-integration.py
!/tests/test-reply-body.ps1
!/tests/test-runtime-coherence.ps1
!/tests/test-script-encoding.ps1

# Retired V0/shadow adapter code
/crates/handoff-windows-adapter/
/adapters/claude/inspect-tail.ps1
/adapters/claude/windows-observe.ps1

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/


# Build output
/target/
*.exe
*.pdb
*.log
# Generated by crates/a2a-ui-windows/build.rs alongside the .rc it writes
*.res

# Local runtime state: sessions, receipts, requests and machine paths
/runtime/*
!/runtime/.gitkeep

# Local development snapshots and generated review artifacts
/backups/
/artifacts/
/.ui-staging/
/tests/__pycache__/
*.pyc

# One-off local migration/debug scripts; keep only deterministic public tests
/tests/*
!/tests/README.md
!/tests/staged-flow-integration.py
!/tests/test-adapter-config.ps1
!/tests/test-agent-docs.ps1
!/tests/test-bootstrap-firstrun.ps1
!/tests/test-claude-anchor-stability.ps1
